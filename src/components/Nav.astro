---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/whats-inside/', label: "What's Inside?" },
  { href: '/illustrations/', label: 'Illustrations' },
  { href: '/buy-now/', label: 'Buy Now' },
];
---

<nav class="bg-white border-b border-border sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-4 relative">
    <!-- Mobile: hamburger + title -->
    <div class="flex items-center justify-between md:hidden py-3">
      <a href="/" class="text-base font-bold text-text">Onions Without Tears</a>
      <button
        id="menu-toggle"
        class="flex items-center gap-2 text-text-muted border border-border rounded-lg px-3 py-2 hover:text-text hover:border-text/30 active:bg-onion active:text-white active:border-onion active:scale-95 transition-all duration-150"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span class="text-base font-semibold text-text [font-variant:small-caps]">Menu</span>
      </button>
    </div>

    <!-- Mobile menu (hidden by default) — floating dropdown, sized to content, anchored to the button's right edge -->
    <div id="mobile-menu" class="hidden md:hidden absolute right-4 top-full mt-1 bg-white border border-border rounded-lg shadow-lg py-2 z-50">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'block py-2.5 px-6 text-lg transition-colors [font-variant:small-caps] whitespace-nowrap',
            currentPath === href || (href !== '/' && currentPath.startsWith(href))
              ? 'text-onion font-semibold bg-cream'
              : 'text-text-muted hover:text-onion',
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center justify-center gap-1 py-5">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'px-4 py-2 text-base font-medium transition-colors border rounded-full [font-variant:small-caps] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-onion/50',
            currentPath === href || (href !== '/' && currentPath.startsWith(href))
              ? 'text-onion border-onion bg-cream'
              : 'text-text-muted border-transparent hover:text-onion hover:border-onion/40 hover:bg-[#FFFEF9]',
          ]}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(menu?.classList.contains('hidden') === true);
  });
  document.addEventListener('click', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    if (menu.contains(e.target as Node) || toggle?.contains(e.target as Node)) return;
    setOpen(false);
  });
</script>
